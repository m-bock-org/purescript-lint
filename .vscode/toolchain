#!/usr/bin/env bash
# Runs one tool from this repo's flake, so the editor never reaches for a
# globally installed compiler or the one under node_modules.
#
# purs, spago and purs-tidy are symlinks to this file; which one you get
# is the name it was called by. Nothing has to be set up first: if
# .vscode/.toolchain is missing, or older than the flake, this builds it
# and carries on. After that every call is a plain exec, about 20ms - a
# nix invocation costs ~1.5s even with its evaluation cache warm, which
# is why the symlink exists at all.
#
# This file is identical in every repo. Copy it, don't adapt it.
set -euo pipefail

tool="$(basename "$0")"
root="$(dirname "$(readlink -f "$0")")/.."
pin="$root/.vscode/.toolchain"

stale=0
[ -x "$pin/bin/$tool" ] || stale=1
if [ "$stale" = 0 ]; then
  # The link's own mtime is when it was built; its target lives in the
  # store, whose mtimes are always 1970.
  pinned_at="$(stat -c %Y "$pin" 2>/dev/null || echo 0)"
  for f in "$root/flake.nix" "$root/flake.lock"; do
    [ -e "$f" ] && [ "$(stat -c %Y "$f")" -gt "$pinned_at" ] && stale=1
  done
fi

if [ "$stale" = 1 ]; then
  for nix in nix "$HOME/.nix-profile/bin/nix" /nix/var/nix/profiles/default/bin/nix /run/current-system/sw/bin/nix; do
    command -v "$nix" >/dev/null 2>&1 || continue
    "$nix" build "$root#toolchain" -o "$pin" >/dev/null 2>&1 && break
  done
fi

[ -x "$pin/bin/$tool" ] || {
  echo "$tool: could not build $root#toolchain, and nix was not found on PATH" >&2
  exit 127
}

exec "$pin/bin/$tool" "$@"
