#!/usr/bin/env bash
# The IDE extension runs the toolchain through here, so it gets the
# versions this repo's flake pins - never a globally installed one, and
# never node_modules'.
#
# Nothing has to be set up first. If .vscode/.toolchain is missing or
# older than the flake, this builds it and carries on; after that every
# call is a direct exec, about 10ms. Entering `nix develop` refreshes it
# too, but nobody has to remember to.
set -euo pipefail
root="$(dirname "$(readlink -f "$0")")/.."
pin="$root/.vscode/.toolchain"

stale=0
[ -x "$pin/bin/purs" ] || stale=1
if [ "$stale" = 0 ]; then
  # The symlink's own mtime is when it was built; the store path's is
  # always 1970, so compare against the link rather than its target.
  pinned_at="$(stat -c %Y "$pin" 2>/dev/null || echo 0)"
  for f in "$root/flake.nix" "$root/flake.lock"; do
    [ -e "$f" ] || continue
    [ "$(stat -c %Y "$f")" -gt "$pinned_at" ] && stale=1
  done
fi

if [ "$stale" = 1 ]; then
  for candidate in nix "$HOME/.nix-profile/bin/nix" /nix/var/nix/profiles/default/bin/nix /run/current-system/sw/bin/nix; do
    command -v "$candidate" >/dev/null 2>&1 || continue
    "$candidate" build "$root#toolchain" -o "$pin" >/dev/null 2>&1 && break
  done
fi

if [ ! -x "$pin/bin/purs" ]; then
  echo "purs: could not build $root#toolchain, and nix was not found on PATH" >&2
  exit 127
fi

exec "$pin/bin/purs" "$@"
