#!/usr/bin/env bash
# The IDE extension runs the toolchain through here, so it gets the
# versions this repo's flake pins rather than whatever is installed
# globally or under node_modules. Built rather than entered: a dev shell
# would print its greeting onto the tool's own stdout.
set -euo pipefail
root="$(dirname "$(readlink -f "$0")")/.."
exec "$(nix build "$root#toolchain" --no-link --print-out-paths)/bin/purs" "$@"
