#!/usr/bin/env bash
# The IDE extension runs the toolchain through here, so it gets the
# versions this repo's flake pins - never a globally installed one, and
# never node_modules'. Works however the editor was started.
#
# `just ide-setup` pins .vscode/.toolchain, which skips a Nix evaluation
# on every call; without it this still works, just slower.
set -euo pipefail
root="$(dirname "$(readlink -f "$0")")/.."
pinned="$root/.vscode/.toolchain/bin/purs"
if [ -x "$pinned" ]; then exec "$pinned" "$@"; fi
exec "$(nix build "$root#toolchain" --no-link --print-out-paths)/bin/purs" "$@"
