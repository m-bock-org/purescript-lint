{
  // The extension resolves executables through PATH, so the toolchain has
  // to BE on PATH: direnv (`direnv allow` once per checkout), or an
  // editor started from `nix develop`. Without that, the IDE server never
  // starts - "Couldn't find IDE server, looked for: purs" - and
  // formatting fails with "not found: purs-tidy".
  //
  // .vscode/purs cannot help here. pursExe is documented as "resolved wrt
  // PATH", so a relative path is looked up as a command name and is not
  // found. And there is no pursTidyExe setting at all; the formatter is
  // named, not located.
  "purescript.formatter": "purs-tidy",

  // buildCommand is the exception, and the only place a wrapper works: it
  // is a command line rather than an executable lookup, so the relative
  // path resolves against the workspace root. The wrapper puts the pinned
  // toolchain on PATH for what it spawns, so spago finds the right purs.
  "purescript.buildCommand": ".vscode/spago build --purs-args --json-errors",

  // Whether to add spago sources to the globs passed to the IDE server.
  // Shells out to a bare `spago`, so this needs PATH too.
  "purescript.addSpagoSources": true,

  // The npm bin directory holds a second purs and a second spago whose
  // versions are pinned in package.json, not in the flake. Keeping it off
  // the extension's PATH is why the dev shell has to supply them instead.
  "purescript.addNpmPath": false
}
